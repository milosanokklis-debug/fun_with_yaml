---
# =============================================================================
# GROUP 04 - Ansible Lab Playbook
# =============================================================================
# OBJECTIVES:
#   - SysAdmin Task 1 : Manage /etc/hosts and Windows hosts file consistency
#   - SysAdmin Task 2 : Install and configure a basic log aggregation agent
#                       (rsyslog on Rocky, Windows Event Forwarding prep)
#   - Hardening Task 1: Configure file permission auditing (auditd on Rocky,
#                       Object Access Auditing on Windows)
#   - Hardening Task 2: Set umask and file creation defaults (Rocky)
#                       and enable Credential Guard registry prep (Windows)
#   - GPO Task 1      : Disable storing LAN Manager hash (NTLMv1 mitigation)
#   - GPO Task 2      : Enable audit policy for logon events
#   - GPO Task 3      : Prevent users from installing software (Windows)
#
# ENVIRONMENT ASSUMPTIONS:
#   - Inventory groups: [windows] = AD01, MGMT01, WKS01
#                       [rocky]   = Ansible01, Ansible02
#   - WinRM configured on Windows hosts
#   - SSH configured on Rocky hosts
#   - Forward and reverse DNS functioning for all hosts
#
# USAGE:
#   Dry-run (highly recommended first):
#     ansible-playbook group_04.yml --check
#   Apply changes:
#     ansible-playbook group_04.yml
# =============================================================================


# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# PLAY 1: SysAdmin - Populate /etc/hosts on Rocky hosts
# WHY: In lab environments, DNS can sometimes fail or be unavailable.
#      A consistent /etc/hosts ensures connectivity to critical hosts.
# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
- name: "SYSADMIN-01 | Populate /etc/hosts on Rocky hosts"
  hosts: rocky
  become: true

  vars:
    # Key lab hosts to add; adjust IPs to match your actual environment
    lab_hosts:
      - ip: "192.168.1.10"
        name: "AD01"
        aliases: "AD01.lab.local"
      - ip: "192.168.1.11"
        name: "MGMT01"
        aliases: "MGMT01.lab.local"
      - ip: "192.168.1.12"
        name: "WKS01"
        aliases: "WKS01.lab.local"
      - ip: "192.168.1.20"
        name: "Controller"
        aliases: "Controller.lab.local"
      - ip: "192.168.1.21"
        name: "Ansible01"
        aliases: "Ansible01.lab.local"
      - ip: "192.168.1.22"
        name: "Ansible02"
        aliases: "Ansible02.lab.local"

  tasks:

    - name: "Add lab host entries to /etc/hosts"
      # ansible.builtin.lineinfile ensures each entry exists exactly once
      ansible.builtin.lineinfile:
        path: /etc/hosts
        regexp: "^{{ item.ip }}\\s"    # Match lines starting with this IP
        line: "{{ item.ip }}  {{ item.name }}  {{ item.aliases }}"
        state: present
      loop: "{{ lab_hosts }}"
      register: hosts_result

    - name: "Debug - Show /etc/hosts changes"
      ansible.builtin.debug:
        msg: "Host entry '{{ item.item.name }}' changed: {{ item.changed }}"
      loop: "{{ hosts_result.results }}"

    - name: "Display current /etc/hosts for review"
      ansible.builtin.command: cat /etc/hosts
      register: hosts_file
      changed_when: false

    - name: "Show /etc/hosts content"
      ansible.builtin.debug:
        msg: |
          === /etc/hosts on {{ inventory_hostname }} ===
          {{ hosts_file.stdout }}

    - name: "Test DNS resolution for AD01 from Rocky host"
      ansible.builtin.command: "getent hosts AD01"
      register: dns_test
      changed_when: false
      failed_when: false

    - name: "Show DNS test result"
      ansible.builtin.debug:
        msg: "AD01 resolution: {{ dns_test.stdout if dns_test.stdout else 'Could not resolve (check DNS or /etc/hosts)' }}"


# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# PLAY 2: SysAdmin - Add lab host entries to Windows hosts file
# WHY: Mirrors the Rocky /etc/hosts update for Windows hosts; ensures
#      consistent name resolution fallback across all lab machines.
# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
- name: "SYSADMIN-01 | Populate Windows hosts file"
  hosts: windows
  gather_facts: false

  vars:
    lab_hosts_win:
      - ip: "192.168.1.10"
        name: "AD01"
      - ip: "192.168.1.20"
        name: "Controller"
      - ip: "192.168.1.21"
        name: "Ansible01"
      - ip: "192.168.1.22"
        name: "Ansible02"

  tasks:

    - name: "Add lab entries to C:\\Windows\\System32\\drivers\\etc\\hosts"
      # win_lineinfile works like lineinfile but for Windows file paths
      ansible.windows.win_lineinfile:
        path: C:\Windows\System32\drivers\etc\hosts
        regexp: "^{{ item.ip }}\\s"
        line: "{{ item.ip }}  {{ item.name }}"
        state: present
      loop: "{{ lab_hosts_win }}"
      register: win_hosts_result

    - name: "Debug - Windows hosts file changes"
      ansible.builtin.debug:
        msg: "Entry '{{ item.item.name }}' changed: {{ item.changed }}"
      loop: "{{ win_hosts_result.results }}"

    - name: "Verify Windows hosts file content"
      ansible.windows.win_shell: |
        Get-Content C:\Windows\System32\drivers\etc\hosts | Out-String
      register: win_hosts_content
      changed_when: false

    - name: "Display Windows hosts file"
      ansible.builtin.debug:
        msg: |
          === hosts file: {{ inventory_hostname }} ===
          {{ win_hosts_content.stdout }}


# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# PLAY 3: SysAdmin - Configure rsyslog on Rocky hosts
# WHY: Centralized logging is a core requirement for security monitoring.
#      rsyslog can forward logs to a SIEM or central syslog server.
# NOTE: In this lab, we configure rsyslog to write structured local logs
#       and prepare for forwarding (destination commented for lab flexibility).
# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
- name: "SYSADMIN-02 | Configure rsyslog on Rocky hosts"
  hosts: rocky
  become: true

  vars:
    # Log file for structured audit-style output
    ansible_log_file: /var/log/ansible_lab.log
    # Uncomment and set if forwarding to a syslog server
    # syslog_server: "192.168.1.50"
    # syslog_port: "514"

  tasks:

    - name: "Ensure rsyslog is installed"
      ansible.builtin.dnf:
        name: rsyslog
        state: present

    - name: "Ensure rsyslog is enabled and running"
      ansible.builtin.service:
        name: rsyslog
        state: started
        enabled: true

    - name: "Deploy custom rsyslog config for lab logging"
      ansible.builtin.copy:
        content: |
          # Ansible Managed - Lab rsyslog configuration
          # Log all auth messages to a dedicated file
          auth,authpriv.*    /var/log/secure
          # Log all kernel messages
          kern.*             /var/log/messages
          # Ansible lab custom log (all facility, warning and above)
          *.warning          {{ ansible_log_file }}
          # Uncomment to forward to central syslog:
          # *.* @{{ '{{ syslog_server }}' }}:{{ '{{ syslog_port }}' }}
        dest: /etc/rsyslog.d/99-ansible-lab.conf
        owner: root
        group: root
        mode: '0640'
      notify: Restart rsyslog

    - name: "Ensure ansible lab log file exists with correct permissions"
      ansible.builtin.file:
        path: "{{ ansible_log_file }}"
        state: touch
        owner: root
        group: root
        mode: '0640'
      changed_when: false   # touch always changes mtime; suppress false positive

    - name: "Verify rsyslog config syntax"
      ansible.builtin.command: rsyslogd -N1
      register: rsyslog_syntax
      changed_when: false
      failed_when: rsyslog_syntax.rc != 0

    - name: "Display rsyslog syntax check result"
      ansible.builtin.debug:
        msg: "rsyslog syntax OK on {{ inventory_hostname }}"

  handlers:
    - name: Restart rsyslog
      ansible.builtin.service:
        name: rsyslog
        state: restarted


# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# PLAY 4: SysAdmin - Prepare Windows Event Forwarding (WEF) subscription
# WHY: WEF allows centralizing Windows event logs without a third-party agent.
#      Here we enable the WinRM listener and verify WEF readiness.
# NOTE: Full WEF setup requires a collector server; this play preps clients.
# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
- name: "SYSADMIN-02 | Prepare Windows Event Forwarding readiness"
  hosts: windows
  gather_facts: false

  tasks:

    - name: "Ensure Windows Remote Management (WinRM) service is running"
      ansible.windows.win_service:
        name: WinRM
        state: started
        start_mode: auto

    - name: "Enable the Windows Event Collector service"
      ansible.windows.win_service:
        name: Wecsvc
        state: started
        start_mode: auto
      ignore_errors: true   # Wecsvc may not be available on all SKUs

    - name: "Check current event log subscription status"
      ansible.windows.win_shell: |
        wecutil es 2>&1 | Out-String
      register: wef_status
      changed_when: false
      failed_when: false

    - name: "Display WEF subscription status"
      ansible.builtin.debug:
        msg: |
          === WEF Subscriptions on {{ inventory_hostname }} ===
          {{ wef_status.stdout if wef_status.stdout else 'No active subscriptions found.' }}

    - name: "Verify event log service is running"
      ansible.windows.win_shell: |
        Get-Service EventLog | Select-Object Name, Status | Format-Table | Out-String
      register: evlog_status
      changed_when: false

    - name: "Show event log service status"
      ansible.builtin.debug:
        msg: "{{ inventory_hostname }}: {{ evlog_status.stdout }}"


# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# PLAY 5: Hardening - Configure auditd rules on Rocky hosts
# WHY: auditd is the Linux kernel audit framework. It tracks file access,
#      privilege use, and authentication events for forensic review.
# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
- name: "HARDENING-01 | Configure auditd rules on Rocky hosts"
  hosts: rocky
  become: true

  tasks:

    - name: "Ensure auditd is installed"
      ansible.builtin.dnf:
        name:
          - audit
          - audit-libs
        state: present

    - name: "Ensure auditd is enabled and running"
      ansible.builtin.service:
        name: auditd
        state: started
        enabled: true

    - name: "Deploy auditd rules file"
      ansible.builtin.copy:
        content: |
          # Ansible Managed - auditd rules for lab hardening
          # Delete all existing rules before applying
          -D
          # Set buffer size (increase if audit events are being dropped)
          -b 8192
          # Monitor changes to /etc/passwd (user account modifications)
          -w /etc/passwd -p wa -k user_accounts
          # Monitor changes to /etc/shadow (password changes)
          -w /etc/shadow -p wa -k shadow_file
          # Monitor changes to /etc/sudoers (privilege escalation config)
          -w /etc/sudoers -p wa -k sudoers_change
          # Monitor SSH authorized_keys files
          -w /root/.ssh -p wa -k root_ssh
          # Monitor for use of privileged commands
          -a always,exit -F arch=b64 -S execve -F euid=0 -k root_commands
          # Monitor for failed login attempts
          -w /var/log/faillog -p wa -k login_failures
          # Make config immutable (requires reboot to change rules)
          # Uncomment when ready: -e 2
        dest: /etc/audit/rules.d/ansible-lab.rules
        owner: root
        group: root
        mode: '0640'
      notify: Reload auditd

    - name: "Verify auditd is loading rules"
      ansible.builtin.command: auditctl -l
      register: audit_rules
      changed_when: false

    - name: "Display active auditd rules"
      ansible.builtin.debug:
        msg: |
          === Auditd Rules on {{ inventory_hostname }} ===
          {{ audit_rules.stdout }}

  handlers:
    - name: Reload auditd
      # auditd requires SIGHUP or service restart to reload rules
      ansible.builtin.command: augenrules --load
      changed_when: true


# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# PLAY 6: Hardening - Enable Object Access Auditing on Windows
# WHY: Without auditing, file/object access goes unrecorded. Enabling these
#      policies feeds the Security event log for SIEM consumption.
# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
- name: "HARDENING-01 | Enable Object Access and Audit policies (Windows)"
  hosts: windows
  gather_facts: false

  tasks:

    - name: "Enable Audit Object Access (success and failure)"
      ansible.windows.win_shell: |
        auditpol /set /subcategory:"File System" /success:enable /failure:enable
      register: audit_obj
      changed_when: audit_obj.rc == 0

    - name: "Enable Audit Logon Events (success and failure)"
      ansible.windows.win_shell: |
        auditpol /set /subcategory:"Logon" /success:enable /failure:enable
      register: audit_logon
      changed_when: audit_logon.rc == 0

    - name: "Enable Audit Account Management (success and failure)"
      ansible.windows.win_shell: |
        auditpol /set /subcategory:"User Account Management" /success:enable /failure:enable
      register: audit_acct
      changed_when: audit_acct.rc == 0

    - name: "Verify current audit policy"
      ansible.windows.win_shell: |
        auditpol /get /category:* | Out-String
      register: auditpol_output
      changed_when: false

    - name: "Display audit policy summary"
      ansible.builtin.debug:
        msg: |
          === Audit Policy: {{ inventory_hostname }} ===
          {{ auditpol_output.stdout[:2000] }}   # Truncate large output for readability


# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# PLAY 7: Hardening - Set secure umask defaults on Rocky hosts
# WHY: Default umask 022 allows group-readable files. A stricter umask (027
#      or 077) prevents accidental world-readable file creation.
# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
- name: "HARDENING-02 | Set secure umask on Rocky hosts"
  hosts: rocky
  become: true

  vars:
    secure_umask: "027"   # Files: 640, Dirs: 750

  tasks:

    - name: "Set umask in /etc/profile"
      ansible.builtin.lineinfile:
        path: /etc/profile
        regexp: '^umask'
        line: "umask {{ secure_umask }}"
        state: present

    - name: "Set umask in /etc/bashrc"
      ansible.builtin.lineinfile:
        path: /etc/bashrc
        regexp: '^umask'
        line: "umask {{ secure_umask }}"
        state: present

    - name: "Set umask in /etc/login.defs for PAM-based logins"
      ansible.builtin.lineinfile:
        path: /etc/login.defs
        regexp: '^UMASK'
        line: "UMASK {{ secure_umask }}"
        state: present

    - name: "Verify umask settings in /etc/profile"
      ansible.builtin.command: grep -n umask /etc/profile /etc/bashrc /etc/login.defs
      register: umask_verify
      changed_when: false

    - name: "Display umask settings"
      ansible.builtin.debug:
        msg: |
          === Umask Settings on {{ inventory_hostname }} ===
          {{ umask_verify.stdout }}


# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# PLAY 8: Hardening - Prepare Credential Guard registry settings (Windows)
# WHY: Credential Guard isolates LSASS in a virtualization-based security
#      container, preventing Pass-the-Hash and credential dumping attacks.
# NOTE: Full VBS/Credential Guard requires UEFI + Secure Boot + TPM.
#       This play sets registry keys to enable it when hardware supports it.
# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
- name: "HARDENING-02 | Configure Credential Guard registry (Windows)"
  hosts: windows
  gather_facts: false

  tasks:

    - name: "Enable Device Guard / Virtualization Based Security"
      ansible.windows.win_regedit:
        path: HKLM:\SYSTEM\CurrentControlSet\Control\DeviceGuard
        name: EnableVirtualizationBasedSecurity
        data: 1
        type: dword

    - name: "Set VBS - require Secure Boot"
      ansible.windows.win_regedit:
        path: HKLM:\SYSTEM\CurrentControlSet\Control\DeviceGuard
        name: RequirePlatformSecurityFeatures
        data: 1    # 1 = Secure Boot only; 3 = Secure Boot + DMA protection
        type: dword

    - name: "Enable Credential Guard (UEFI lock)"
      ansible.windows.win_regedit:
        path: HKLM:\SYSTEM\CurrentControlSet\Control\LSA
        name: LsaCfgFlags
        data: 1    # 1 = Enabled with UEFI lock; 2 = Enabled without lock
        type: dword

    - name: "Verify Credential Guard registry values"
      ansible.windows.win_shell: |
        $dg = Get-ItemProperty "HKLM:\SYSTEM\CurrentControlSet\Control\DeviceGuard" -ErrorAction SilentlyContinue
        $lsa = Get-ItemProperty "HKLM:\SYSTEM\CurrentControlSet\Control\LSA" -ErrorAction SilentlyContinue
        Write-Output "VBS=$($dg.EnableVirtualizationBasedSecurity) | LsaCfgFlags=$($lsa.LsaCfgFlags)"
      register: credguard_verify
      changed_when: false

    - name: "Display Credential Guard status"
      ansible.builtin.debug:
        msg: "{{ inventory_hostname }}: {{ credguard_verify.stdout }}"

    - name: "Remind user that reboot is required"
      ansible.builtin.debug:
        msg: "NOTE: Credential Guard changes on {{ inventory_hostname }} require a reboot to take effect."


# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# PLAY 9: GPO-01 - Disable storing LAN Manager hash (Windows)
# WHY: LM hashes are extremely weak and easily cracked. NoLMHash prevents
#      Windows from storing the weak hash on password change.
#      Equivalent to: Computer Config > Security Settings > Local Policies
#      > Security Options > "Do not store LAN Manager hash value"
# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
- name: "GPO-01 | Disable LAN Manager hash storage (Windows)"
  hosts: windows
  gather_facts: false

  tasks:

    - name: "Set NoLMHash registry key to disable LM hash storage"
      ansible.windows.win_regedit:
        path: HKLM:\SYSTEM\CurrentControlSet\Control\Lsa
        name: NoLMHash
        data: 1
        type: dword

    - name: "Verify NoLMHash is set"
      ansible.windows.win_shell: |
        $val = (Get-ItemProperty "HKLM:\SYSTEM\CurrentControlSet\Control\Lsa").NoLMHash
        Write-Output "NoLMHash = $val (1=Enabled, LM hash will NOT be stored)"
      register: lm_verify
      changed_when: false

    - name: "Display LM hash policy status"
      ansible.builtin.debug:
        msg: "{{ inventory_hostname }}: {{ lm_verify.stdout }}"


# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# PLAY 10: GPO-02 - Enable audit policy for logon/account logon events
# WHY: Auditing logon events helps detect brute-force and unauthorized access.
#      Equivalent to: Computer Config > Security Settings > Advanced Audit
#      Policy > Account Logon / Logon/Logoff
# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
- name: "GPO-02 | Enable comprehensive logon auditing (Windows)"
  hosts: windows
  gather_facts: false

  tasks:

    - name: "Audit Account Logon (Kerberos, NTLM)"
      ansible.windows.win_shell: |
        auditpol /set /category:"Account Logon" /success:enable /failure:enable
      register: acct_logon
      changed_when: acct_logon.rc == 0

    - name: "Audit Logon/Logoff events"
      ansible.windows.win_shell: |
        auditpol /set /category:"Logon/Logoff" /success:enable /failure:enable
      register: logon_logoff
      changed_when: logon_logoff.rc == 0

    - name: "Audit Privilege Use events (failure only to reduce noise)"
      ansible.windows.win_shell: |
        auditpol /set /category:"Privilege Use" /success:disable /failure:enable
      register: priv_use
      changed_when: priv_use.rc == 0

    - name: "Verify logon audit settings"
      ansible.windows.win_shell: |
        auditpol /get /category:"Account Logon","Logon/Logoff" | Out-String
      register: logon_audit_verify
      changed_when: false

    - name: "Display logon audit verification"
      ansible.builtin.debug:
        msg: |
          === Logon Audit Policy: {{ inventory_hostname }} ===
          {{ logon_audit_verify.stdout }}


# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# PLAY 11: GPO-03 - Prevent standard users from installing software (Windows)
# WHY: Restricting software installation prevents malware persistence and
#      unauthorized application deployment.
#      Equivalent to: Computer Config > Admin Templates > Windows Components
#      > Windows Installer > "Prohibit User Installs"
# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
- name: "GPO-03 | Prevent standard users from installing software (Windows)"
  hosts: windows
  gather_facts: false

  tasks:

    - name: "Disable Windows Installer for non-admin users"
      # DisableMSI = 2 = disallow all installs by non-admins
      ansible.windows.win_regedit:
        path: HKLM:\SOFTWARE\Policies\Microsoft\Windows\Installer
        name: DisableMSI
        data: 2
        type: dword

    - name: "Disable elevated install privileges for users"
      # AlwaysInstallElevated should be 0 to prevent privilege escalation via MSI
      ansible.windows.win_regedit:
        path: HKLM:\SOFTWARE\Policies\Microsoft\Windows\Installer
        name: AlwaysInstallElevated
        data: 0
        type: dword

    - name: "Also set HKCU-equivalent via machine policy"
      ansible.windows.win_regedit:
        path: HKLM:\SOFTWARE\Policies\Microsoft\Windows\Installer
        name: EnableUserControl
        data: 0
        type: dword

    - name: "Verify installer restriction settings"
      ansible.windows.win_shell: |
        $path = "HKLM:\SOFTWARE\Policies\Microsoft\Windows\Installer"
        $props = Get-ItemProperty $path -ErrorAction SilentlyContinue
        Write-Output "DisableMSI=$($props.DisableMSI) | AlwaysInstallElevated=$($props.AlwaysInstallElevated) | EnableUserControl=$($props.EnableUserControl)"
      register: installer_verify
      changed_when: false

    - name: "Display installer restriction status"
      ansible.builtin.debug:
        msg: "{{ inventory_hostname }}: {{ installer_verify.stdout }}"

